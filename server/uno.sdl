type Card {
  type: String!
  color: String
  number: Int
}

type ActiveGame {
  id: ID!
  pending: Boolean!
  players: [String!]!
  playerInTurn: Int
  hand: [Card!]
  handSizes: [Int!]!
  topCard: Card!
  currentColor: String!
  direction: String!
  drawPileSize: Int!
  winner: Int
  score: Int
}

type Query {
  game(id: ID!): ActiveGame
}

type Mutation {
  playCard(id: ID!, cardIndex: Int!, color: String, sayUno: Boolean!): ActiveGame!
  drawCard(id: ID!): ActiveGame!
  sayUno(id: ID!): ActiveGame!
  catchUnoFailure(id: ID!, accused: Int!): ActiveGame!
}

type Subscription {
  gameUpdated: ActiveGame
}
